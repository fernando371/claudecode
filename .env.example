# =====================================================================
# FDC WhatsApp AI - modelo de variaveis de ambiente
# ---------------------------------------------------------------------
# COPIE este arquivo para ".env" e preencha SOMENTE quando necessario.
# NUNCA coloque valores reais neste arquivo (.env.example vai para o Git).
# NUNCA envie chaves ou tokens pelo chat.
# =====================================================================

# --- Ambiente ---
NODE_ENV=development
APP_ENV=dev                      # dev | teste | producao
LOG_LEVEL=info
API_PORT=3333
ADMIN_PORT=3000
API_PUBLIC_URL=http://localhost:3333
ADMIN_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Banco local (prototipo) ---
DATABASE_FILE=./data/runtime/fdc.db

# --- Interruptores de emergencia (chaves gerais) ---
AI_ENABLED=true                  # false = IA desligada, so respostas seguras/humano
WHATSAPP_ENABLED=true            # false = canal WhatsApp desligado
HUMAN_ONLY_MODE=false            # true = tudo vai para atendente humano
OUTBOUND_CAMPAIGNS_ENABLED=false # envio ativo (campanhas). Mantenha false nesta fase.

# --- TRAVA PRINCIPAL: envio real pelo WhatsApp ---
# Enquanto for "false", nenhuma mensagem real pode sair. NAO mude sem autorizacao.
WHATSAPP_LIVE_ENABLED=false

# --- Escolha dos adaptadores (mock = simulado, sem internet) ---
WHATSAPP_PROVIDER=mock           # mock | meta
CATALOG_PROVIDER=mock            # mock | shopify
ORDER_PROVIDER=mock              # mock | shopify
INVOICE_PROVIDER=mock            # mock | sap
TRACKING_PROVIDER=mock           # mock | mandae | correios | fonteslog | tmlogistica
LLM_PROVIDER=mock                # mock | anthropic

# --- Meta / WhatsApp Business Platform (deixe vazio nesta fase) ---
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Shopify (somente leitura; deixe vazio nesta fase) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_STOREFRONT_BASE_URL=

# --- SAP / Nota Fiscal (contrato ainda pendente) ---
SAP_BASE_URL=
SAP_AUTH_MODE=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=

# --- Logistica (contratos ainda pendentes) ---
MANDAE_BASE_URL=
MANDAE_TOKEN=
CORREIOS_BASE_URL=
CORREIOS_USER=
CORREIOS_TOKEN=
FONTESLOG_BASE_URL=
FONTESLOG_TOKEN=
TMLOGISTICA_BASE_URL=
TMLOGISTICA_TOKEN=

# --- Provedor de IA (cobranca separada da assinatura do Claude Code) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_MAX_OUTPUT_TOKENS=1024

# --- Painel administrativo ---
ADMIN_AUTH_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=                  # defina uma senha local no seu .env
ADMIN_SESSION_SECRET=            # texto aleatorio longo, gerado por voce
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Privacidade / retencao (LGPD) ---
RETENTION_CONVERSATIONS_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_HEALTH_FLAGS_DAYS=30
PII_MASKING_ENABLED=true

# --- Limites ---
RATE_LIMIT_MAX_PER_MINUTE=60          # limite do webhook publico
RATE_LIMIT_PANEL_MAX_PER_MINUTE=600   # limite do painel autenticado
INTEGRATION_TIMEOUT_MS=8000
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000
CAMPAIGN_MAX_PER_CUSTOMER_PER_WEEK=1
